# GEMINI_API_KEY: Optional (Not used during active gameplay — Zero-AI Offline Word Bank).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Passcode for Word Bank Admin Dashboard (set a strong value in production).
ADMIN_PASSCODE="ibn-taymiyah-2026"

# SESSION_SECRET: HMAC secret used to sign admin session cookies/tokens.
SESSION_SECRET="change-this-random-hmac-secret-in-production"
